---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../config';
import PageTransition from '../components/PageTransition.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  showPreloader?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = '/',
  showPreloader = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const ogImage = new URL('/og.svg', site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Physiotherapist', 'MedicalBusiness', 'LocalBusiness'],
      '@id': `${site.url}/#business`,
      name: site.name,
      description: site.description,
      url: site.url,
      image: ogImage,
      medicalSpecialty: ['Geriatric', 'Physiotherapy'],
      areaServed: {
        '@type': 'City',
        name: site.city,
        containedInPlace: {
          '@type': 'State',
          name: 'Minas Gerais',
          addressCountry: 'BR',
        },
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.city,
        addressRegion: site.state,
        addressCountry: 'BR',
      },
      sameAs: [site.instagram.url],
      identifier: {
        '@type': 'PropertyValue',
        name: 'CREFITO',
        value: site.crefito,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      description: site.description,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${site.url}/#business` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#business` },
      inLanguage: 'pt-BR',
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#58595B" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Site de ${site.name}, fisioterapeuta em Belo Horizonte`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter fallback="swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="page-grain" aria-hidden="true"></div>
    <PageTransition />
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <slot />
    <script>
      import { bootMotion } from '../scripts/motion.ts';
      bootMotion();
    </script>
    <script is:inline>
      setTimeout(function () {
        if (!document.documentElement.classList.contains('motion-ready') &&
            !document.documentElement.classList.contains('motion-reduced')) {
          document.documentElement.classList.add('motion-reduced');
          document.documentElement.classList.add('motion-ready');
          var p = document.querySelector('[data-preloader]');
          if (p) p.remove();
          document.body.style.overflow = '';
        }
      }, 4500);
    </script>
    <noscript>
      <style>
        .reveal, [data-hero-line] .hero-line__inner, [data-hero-visual], .hero__badges li {
          opacity: 1 !important; transform: none !important; filter: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
