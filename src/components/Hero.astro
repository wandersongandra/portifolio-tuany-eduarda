---
import { site, whatsappUrl } from '../config';
import LiquidMesh from './LiquidMesh.astro';
const wa = whatsappUrl();
---

<section class="hero" style="position:relative" id="topo" data-bg="cream" aria-labelledby="hero-title">
  <LiquidMesh />
  <div class="blob-field" aria-hidden="true">
    <span class="blob blob--a"></span>
    <span class="blob blob--b"></span>
    <span class="blob blob--c"></span>
  </div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero-line" data-hero-line>
        <span class="hero-line__inner">Fisioterapia com cuidado e presença</span>
      </p>
      <h1 id="hero-title" class="hero-line" data-hero-line>
        <span class="hero-line__inner">{site.name}</span>
      </h1>
      <p class="hero__role hero-line" data-hero-line>
        <span class="hero-line__inner">
          Fisioterapeuta · CREFITO {site.crefito}<br />
          Pós-graduada em Geriatria e Gerontologia
        </span>
      </p>
      <p class="hero__lead hero-line" data-hero-line>
        <span class="hero-line__inner">
          Atendimento domiciliar em Belo Horizonte, com foco em fisioterapia para idosos,
          disfunção temporomandibular (DTM) e dor orofacial (DOF).
        </span>
      </p>
      <div class="btn-row hero-line" data-hero-line>
        <span class="hero-line__inner btn-row" style="gap: 0.75rem; display: inline-flex; flex-wrap: wrap;">
          <a class="btn btn--wa btn--magnetic" href={wa} data-wa-cta>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M20.5 3.5A11 11 0 0 0 3.1 17.7L2 22l4.4-1.1A11 11 0 1 0 20.5 3.5zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.6.7.7-2.5-.2-.3A9 9 0 1 1 12 20.5zm5-6.7c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.1-.3c0-.1 0-.3-.1-.4s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3a2 2 0 0 0-.6 1.5 3.5 3.5 0 0 0 .7 1.8c.1.2 1.4 2.2 3.4 3.1 2 .9 2 .6 2.4.6s1.2-.1 1.4-.3.9-1 1-1.2.2-.3.1-.5-.2-.2-.5-.3z"/>
            </svg>
            Agendar pelo WhatsApp
          </a>
          <a class="btn btn--ghost btn--magnetic" href="#servicos">Conhecer os serviços</a>
        </span>
      </div>
      <ul class="hero__badges" aria-label="Áreas de atuação">
        <li>Atendimento domiciliar</li>
        <li>Fisioterapia em idosos</li>
        <li>DTM e DOF</li>
        <li>Belo Horizonte</li>
      </ul>
    </div>

    <div class="hero__visual" data-hero-visual aria-hidden="true">
      <div class="hero-frame">
        <div class="hero-frame__glow" data-parallax="8"></div>
        <div class="hero-frame__card">
          <div class="hero-frame__photo" data-distort-photo clip-reveal">
            <svg viewBox="0 0 320 400" role="img" aria-label="Espaço reservado para foto profissional">
              <defs>
                <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#E2C4BE"/>
                  <stop offset="100%" stop-color="#C9978F"/>
                </linearGradient>
              </defs>
              <rect width="320" height="400" rx="28" fill="url(#g1)"/>
              <circle cx="160" cy="150" r="54" fill="#9E6F68" opacity="0.35"/>
              <path d="M80 340c20-70 60-100 80-100s60 30 80 100" fill="#9E6F68" opacity="0.28"/>
              <text x="160" y="372" text-anchor="middle" fill="#58595B" font-family="Source Sans 3, sans-serif" font-size="14" opacity="0.7">
                Foto profissional
              </text>
            </svg>
          </div>
          <div class="hero-frame__chip">
            <span>CREFITO {site.crefito}</span>
            <strong>Atendimento em casa</strong>
          </div>
        </div>
        <div class="hero-frame__float">
          <span>Geriatria &amp; Gerontologia</span>
        </div>
        <div class="hero-badge-float" aria-hidden="true">
          <div class="logo-badge-orb">
            <img class="logo-badge-orb__emblem" src="/brand/logo-emblem.svg" width="176" height="176" alt="" />
            <div class="logo-badge-orb__spin">
              <img src="/brand/logo-text-ring.svg" width="176" height="176" alt="" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-7);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero h1 {
    font-size: var(--fs-hero);
    margin-bottom: var(--space-4);
  }

  .hero__role {
    font-size: var(--fs-lead);
    color: var(--graphite-800);
    font-weight: 500;
    margin-bottom: var(--space-4);
    line-height: var(--lh-snug);
  }

  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: 36rem;
    margin-bottom: var(--space-6);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: var(--space-6);
  }

  .hero__badges li {
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .hero-frame {
    position: relative;
    max-width: 26rem;
    margin-inline: auto;
  }

  .hero-frame__glow {
    position: absolute;
    inset: 8% -6% -8% -6%;
    background: radial-gradient(circle at 50% 40%, rgba(122, 154, 136, 0.35), transparent 65%);
    filter: blur(8px);
    z-index: 0;
  }

  .hero-frame__card {
    position: relative;
    z-index: 1;
    background: var(--paper);
    border-radius: 2rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lift);
  }

  .hero-frame__photo {
    border-radius: 1.45rem;
    overflow: hidden;
    background: var(--rose-100);
  }

  .hero-frame__chip {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 0.75rem 0.5rem;
  }

  .hero-frame__chip span {
    color: var(--rose-dark);
  }

  .hero-frame__chip strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--graphite-950);
    font-weight: 550;
  }

  .hero-frame__float {
    position: absolute;
    left: -0.75rem;
    top: 1.25rem;
    right: auto;
    bottom: auto;
    z-index: 2;
    background: var(--graphite-900);
    color: var(--cream);
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow-lift);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
      max-width: 22rem;
      margin-inline: auto;
    }
    .hero-frame__float {
      left: 0.5rem;
      top: 0.75rem;
      right: auto;
      bottom: auto;
    }
  }
</style>
