---
import { services } from '../data/services';

interface Props {
  teaser?: boolean;
}
const { teaser = false } = Astro.props;
const list = teaser ? services.slice(0, 3) : services;
---

<section class="section section--alt" id="servicos" data-bg="sage" aria-labelledby="servicos-title">
  <div class="container">
    <header class="section__header section__header--center reveal">
      <p class="eyebrow" style="justify-content:center">Serviços</p>
      <h2 class="section__title split-headline" id="servicos-title" data-split>
        Cuidado especializado, perto de você
      </h2>
      <p class="section__lead">
        Cuidado individualizado, no conforto de casa, com atenção à mobilidade,
        ao equilíbrio e ao bem-estar no dia a dia.
      </p>
    </header>

    <div class={`grid ${list.length > 3 ? 'grid--2' : 'grid--3'}`} data-stagger>
      {list.map((s) => (
        <article class="card" data-card data-tilt data-cursor="Ver" data-rgb-hover>
          <span class="card__glow" aria-hidden="true"></span>
          <div class="card__icon" aria-hidden="true">
            {s.icon === 'home' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/>
              </svg>
            )}
            {s.icon === 'elder' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="12" cy="7" r="3"/>
                <path d="M6 21v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2"/>
                <path d="M9 14.5 7.5 18M15 14.5 16.5 18"/>
              </svg>
            )}
            {(s.icon === 'jaw' || s.icon === 'face') && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M8 10c0-2.2 1.8-4 4-4s4 1.8 4 4"/>
                <path d="M7 14c1.2 2.2 2.8 3.5 5 3.5s3.8-1.3 5-3.5"/>
                <path d="M5 11h2M17 11h2"/>
              </svg>
            )}
          </div>
          <h3 class="card__title">{s.title}</h3>
          <p class="card__text">{s.text}</p>
          <ul class="card__list">
            {s.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>

    {teaser && (
      <p class="servicos__more">
        <a class="btn btn--ghost" href="/servicos/">Ver todos os serviços</a>
      </p>
    )}

    <p class="servicos__ethics">
      O tratamento é definido após uma avaliação individual, de acordo com as necessidades de cada paciente.
    </p>
  </div>
</section>

<style>
  .servicos__ethics {
    margin-top: var(--space-6);
    text-align: center;
    max-width: 46rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    margin-inline: auto;
  }
  .servicos__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
