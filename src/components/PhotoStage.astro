---
/**
 * Narrative photo stage (v9c):
 * - Hero: no slats — circle mask driven in JS only.
 * - Sobre/Contato: 8–10 image blinds via clip-path (no scaleX — keeps photo aligned).
 *   Base + duotone always visible behind closed regions (never flat rose).
 */
interface Props {
  role: 'hero' | 'sobre' | 'contato';
  transitionName?: string;
  href?: string;
  cursorLabel?: string;
  class?: string;
  slats?: number;
}
const {
  role,
  transitionName = '',
  href,
  cursorLabel,
  class: className = '',
  slats = 9,
} = Astro.props;
const useBlinds = role !== 'hero';
const stripCount = Math.max(8, Math.min(10, slats));
---

{href ? (
  <a
    class:list={['photo-stage', `photo-stage--${role}`, className]}
    data-photo-stage={role}
    data-slat-count={useBlinds ? stripCount : 0}
    href={href}
    data-cursor={cursorLabel || 'Ver'}
    transition:name={transitionName || undefined}
  >
    <div class="photo-stage__media" data-photo-media>
      <div class="photo-stage__base" data-photo-base>
        <slot />
      </div>
      <div class="photo-stage__duotone" data-photo-duotone aria-hidden="true"></div>
      {useBlinds && (
        <div class="photo-stage__blinds" data-photo-blinds aria-hidden="true" style={`--sn:${stripCount}`}>
          {Array.from({ length: stripCount }).map((_, i) => (
            <div class="photo-stage__blind" style={`--si:${i}`}>
              <div class="photo-stage__blind-reveal" data-blind-reveal>
                <div class="photo-stage__blind-img" data-blind-img></div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </a>
) : (
  <div
    class:list={['photo-stage', `photo-stage--${role}`, className]}
    data-photo-stage={role}
    data-slat-count={useBlinds ? stripCount : 0}
    transition:name={transitionName || undefined}
  >
    <div class="photo-stage__media" data-photo-media>
      <div class="photo-stage__base" data-photo-base>
        <slot />
      </div>
      <div class="photo-stage__duotone" data-photo-duotone aria-hidden="true"></div>
      {useBlinds && (
        <div class="photo-stage__blinds" data-photo-blinds aria-hidden="true" style={`--sn:${stripCount}`}>
          {Array.from({ length: stripCount }).map((_, i) => (
            <div class="photo-stage__blind" style={`--si:${i}`}>
              <div class="photo-stage__blind-reveal" data-blind-reveal>
                <div class="photo-stage__blind-img" data-blind-img></div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style>
  .photo-stage {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: inherit;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: #3f4042;
  }
  .photo-stage__media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }
  .photo-stage__base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Hidden while blinds run — parallax scale(1.08) would misalign vs strip BGs.
       Behind closed clips = stage background-image (set in JS) + duotone. */
    opacity: 0;
    z-index: 0;
  }
  .photo-stage.is-open .photo-stage__base {
    opacity: 1;
  }
  .photo-stage__duotone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: color;
    background:
      linear-gradient(180deg, rgba(201, 151, 143, 0.62), rgba(63, 64, 66, 0.5));
    opacity: 1;
  }
  .photo-stage.is-color .photo-stage__duotone {
    opacity: 0;
  }
  .photo-stage__blinds {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(var(--sn, 9), 1fr);
    gap: 0;
    pointer-events: none;
  }
  .photo-stage.is-open .photo-stage__blinds {
    display: none;
  }
  .photo-stage__blind {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }
  .photo-stage__blind-reveal {
    position: absolute;
    inset: 0;
    /* Start ~20% open at center — face peeks; JS animates clip-path */
    clip-path: inset(0 40% 0 40%);
    will-change: clip-path;
  }
  .photo-stage__blind-img {
    position: absolute;
    top: 0;
    height: 100%;
    width: calc(var(--sn, 9) * 100%);
    left: calc(var(--si, 0) * -100%);
    background-size: cover;
    background-position: 50% 18%;
    background-repeat: no-repeat;
  }
  :global(.motion-reduced) .photo-stage__duotone {
    opacity: 0 !important;
  }
  :global(.motion-reduced) .photo-stage__blinds {
    display: none !important;
  }
</style>
