---
import { site } from '../config';
import Portrait from './Portrait.astro';
import PhotoStage from './PhotoStage.astro';
import sobrePhoto from '../assets/photos/tuany-sobre.jpg';
const onSobrePage = Astro.url.pathname.replace(/\/+$/, '').endsWith('/sobre');
---

<section class="section photo-slat-field" id="sobre" aria-labelledby="sobre-title" data-sobre-section data-sobre-mode={onSobrePage ? "page" : "teaser"}>
  <div class="container sobre" data-sobre-grid>
    <div class="sobre__copy reveal">
      <p class="eyebrow">Sobre a profissional</p>
      <h2 class="section__title split-headline" id="sobre-title" data-split>Cuidado próximo, formação sólida</h2>
      <p class="section__lead">
        {site.name} é fisioterapeuta registrada no CREFITO {site.crefito},
        com pós-graduação em Geriatria e Gerontologia. Atua com atendimento
        domiciliar em Belo Horizonte, acompanhando pessoas que precisam de
        reabilitação e cuidado no conforto de casa.
      </p>
      <p class="sobre__text">
        Duas frentes distintas: (1) fisioterapia para idosos — mobilidade,
        autonomia e prevenção de quedas, com base na pós-graduação em Geriatria
        e Gerontologia; (2) tratamento da disfunção temporomandibular (DTM) e
        dor orofacial, para adultos, com avaliação e plano próprios. Cada
        acompanhamento é individualizado.
      </p>
      <dl class="sobre__creds">
        <div>
          <dt>Registro profissional</dt>
          <dd>CREFITO {site.crefito}</dd>
        </div>
        <div>
          <dt>Formação complementar</dt>
          <dd>Pós-graduação em Geriatria e Gerontologia</dd>
        </div>
        <div>
          <dt>Modalidade</dt>
          <dd>Atendimento domiciliar em {site.city}</dd>
        </div>
      </dl>
      {!onSobrePage && (
        <p class="sobre__cta-wrap">
          <a class="btn btn--ghost btn--magnetic" href="/sobre/" data-photo-bridge="sobre">Conhecer a profissional</a>
        </p>
      )}

      <!-- panel-after-creds -->
      <div class="sobre__panel reveal clip-reveal" aria-label="Resumo profissional">
        <div class="sobre__panel-inner">
          <p class="sobre__panel-label">Em destaque</p>
          <ul>
            <li>
              <strong>Fisioterapia em idosos</strong>
              <span>Equilíbrio, mobilidade e autonomia — Geriatria e Gerontologia</span>
            </li>
            <li>
              <strong>Atendimento em casa</strong>
              <span>Conforto e continuidade no dia a dia</span>
            </li>
            <li>
              <strong>Tratamento para DTM</strong>
              <span>Frente própria: articulação temporomandibular e dor orofacial</span>
            </li>
          </ul>
          <p class="sobre__note">
            Atendimento com escuta, presença e plano de cuidado feito sob medida
            para a sua rotina em Belo Horizonte.
          </p>
        </div>
      </div>
    </div>

    <aside class="sobre__aside">
      <figure class="sobre__photo" data-sobre-photo data-photo-tilt>
        <PhotoStage
          role="sobre"
          transitionName="photo-sobre"
          href={onSobrePage ? undefined : '/sobre/'}
          cursorLabel="Conhecer"
          slats={10}
        >
          <div class="photo-parallax" data-photo-inner>
            <Portrait
              src={sobrePhoto}
              alt="Tuany Eduarda, fisioterapeuta, em retrato editorial de corpo inteiro"
              widths={[320, 480, 640, 800, 1200]}
              sizes="(max-width: 900px) min(92vw, 28rem), min(36vw, 28rem)"
              loading="lazy"
              objectPosition="50% 12%"
              class="sobre__img"
            />
          </div>
        </PhotoStage>
        <figcaption class="sr-only">Retrato profissional de {site.name}</figcaption>
      </figure>

    </aside>
  </div>
</section>

<style>
  :global(#sobre),
  :global(section[data-sobre-section]) {
    position: relative;
    z-index: 2;
    background: var(--cream, #F7F3EE);
    isolation: isolate;
  }
  .sobre {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .sobre__cta-wrap {
    margin-top: var(--space-5);
  }
  .sobre__text {
    margin-top: var(--space-4);
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .sobre__creds {
    display: grid;
    gap: 1rem;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .sobre__creds dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-dark);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .sobre__creds dd {
    margin: 0;
    font-weight: 550;
    color: var(--graphite-950);
  }

  .sobre__aside {
    display: grid;
    gap: 1.25rem;
  }

  .sobre__photo {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #3f4042; /* photo stage fallback — never flat rose bleed */
    aspect-ratio: 3 / 4;
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--line);
  }
  @media (min-width: 901px) {
    .sobre__photo {
      position: sticky;
      top: calc(var(--header-h, 4.25rem) + 1rem);
      z-index: 1;
    }
    .sobre__aside {
      align-content: start;
    }
  }

  .sobre__photo :global(.photo-stage),
  .sobre__photo :global(.photo-stage__media),
  .sobre__photo :global(.photo-stage__base),
  .sobre__photo :global(picture),
  .sobre__photo :global(img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .sobre__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }
  .photo-parallax {
    width: 100%;
    height: 100%;
    transform: scale(1.08);
    will-change: transform;
  }

  .sobre__copy .sobre__panel {
    margin-top: var(--space-6);
  }

  .sobre__panel-inner {
    background: var(--graphite-900);
    color: var(--rose-100);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-lift);
  }

  .sobre__panel-label {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose-soft);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }

  .sobre__panel ul {
    display: grid;
    gap: 1.15rem;
  }

  .sobre__panel li {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(232, 240, 234, 0.12);
  }

  .sobre__panel li:last-of-type {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .sobre__panel strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: #fff;
    font-weight: 550;
  }

  .sobre__panel span {
    color: var(--rose-soft);
    font-size: var(--fs-small);
  }

  .sobre__note {
    margin-top: var(--space-5);
    font-size: 0.82rem;
    color: var(--rose-soft);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .sobre {
      grid-template-columns: 1fr;
    }
    .sobre__photo {
      max-width: 28rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
