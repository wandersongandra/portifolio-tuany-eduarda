---
<section class="big-type" data-big-type aria-label="Destaque">
  <div class="big-type__sticky">
    <p class="big-type__eyebrow">Presença que acompanha</p>
    <h2 class="big-type__line" data-big-fill aria-hidden="true">
      <span class="big-type__outline">Cuidado que vai até você</span>
      <span class="big-type__fill">Cuidado que vai até você</span>
    </h2>
    <p class="sr-only">Cuidado que vai até você</p>
  </div>
</section>

<style>
  .big-type {
    position: relative;
    z-index: 0;
    height: 100vh;
    background: var(--graphite-950);
    color: var(--cream);
    overflow: clip;
    isolation: isolate;
  }
  .big-type__sticky {
    position: sticky;
    /* Stick BELOW fixed header so no graphite band peeks under it */
    top: var(--header-h, 4.25rem);
    height: calc(100vh - var(--header-h, 4.25rem));
    display: grid;
    place-content: center;
    text-align: center;
    padding: var(--gutter);
    overflow: hidden;
    background: var(--graphite-950);
  }
  .big-type__eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rose);
    margin-bottom: 1.25rem;
    font-weight: 600;
  }
  .big-type__line {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }
  .big-type__outline,
  .big-type__fill {
    display: block;
  }
  .big-type__outline {
    color: transparent;
    -webkit-text-stroke: 1.25px rgba(235, 229, 223, 0.55);
  }
  .big-type__fill {
    position: absolute;
    inset: 0;
    color: var(--cream);
    clip-path: inset(0 100% 0 0);
  }
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .big-type {
      height: auto;
      min-height: 0;
      /* Hard stop — never paint into the next section on mobile */
      overflow: hidden;
      margin: 0;
      padding: 0;
    }
    .big-type__sticky {
      position: relative;
      top: auto;
      height: auto;
      min-height: 0;
      padding-block: clamp(3rem, 12vw, 4.75rem);
      transform: none !important;
    }
    .big-type__fill { clip-path: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .big-type__outline { display: none; }
  }
</style>
