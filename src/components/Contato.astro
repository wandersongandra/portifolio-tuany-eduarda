---
import { site, whatsappUrl } from '../config';
const wa = whatsappUrl();
---

<section id="contato" aria-labelledby="contato-title">
  <div class="contato reveal">
    <div class="contato__copy">
      <p class="eyebrow" style="color: var(--rose-soft)">Contato</p>
      <h2 class="section__title split-headline" id="contato-title" data-split>Vamos conversar sobre o seu cuidado</h2>
      <p class="contato__lead">
        Envie uma mensagem pelo WhatsApp ou Instagram. Informe o motivo do
        atendimento e o bairro em Belo Horizonte para combinarmos a avaliação.
      </p>

      {site.whatsappIsPlaceholder && (
        <p class="contato__placeholder" role="note">
          O número de WhatsApp ainda é um <strong>placeholder</strong> neste site.
          Assim que a profissional informar o número real, o botão passará a abrir
          a conversa diretamente. Enquanto isso, use o Instagram.
        </p>
      )}

      <div class="btn-row">
        <a class="btn btn--wa btn--magnetic" href={wa} data-wa-cta>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M20.5 3.5A11 11 0 0 0 3.1 17.7L2 22l4.4-1.1A11 11 0 1 0 20.5 3.5zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.6.7.7-2.5-.2-.3A9 9 0 1 1 12 20.5zm5-6.7c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.1-.3c0-.1 0-.3-.1-.4s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3a2 2 0 0 0-.6 1.5 3.5 3.5 0 0 0 .7 1.8c.1.2 1.4 2.2 3.4 3.1 2 .9 2 .6 2.4.6s1.2-.1 1.4-.3.9-1 1-1.2.2-.3.1-.5-.2-.2-.5-.3z"/>
          </svg>
          WhatsApp
        </a>
        <a
          class="btn btn--light btn--magnetic"
          href={site.instagram.url}
          rel="noopener noreferrer"
          target="_blank"
        >
          Instagram {site.instagram.handle}
        </a>
      </div>
    </div>

    <div class="contato__card">
      <dl>
        <div>
          <dt>Profissional</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>CREFITO</dt>
          <dd>{site.crefito}</dd>
        </div>
        <div>
          <dt>Cidade</dt>
          <dd>{site.city}, {site.state}</dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd>
            <a href={site.instagram.url} rel="noopener noreferrer" target="_blank">
              {site.instagram.handle}
            </a>
          </dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>
            {site.whatsappIsPlaceholder
              ? 'Aguardando número da profissional'
              : site.whatsapp}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contato {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-6);
    align-items: stretch;
    background: linear-gradient(135deg, #3F4042, #58595B);
    color: var(--rose-50);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-lift);
  }

  .contato .section__title {
    color: #fff;
  }

  .contato__lead {
    color: var(--rose-100);
    font-size: var(--fs-lead);
    margin-bottom: var(--space-5);
    max-width: 36rem;
  }

  .contato__placeholder {
    background: rgba(250, 247, 242, 0.1);
    border: 1px solid rgba(250, 247, 242, 0.18);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
    margin-bottom: var(--space-5);
    font-size: var(--fs-small);
    color: var(--rose-100);
  }

  .contato__card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    backdrop-filter: blur(6px);
  }

  .contato__card dl {
    display: grid;
    gap: 1rem;
  }

  .contato__card dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-soft);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .contato__card dd {
    margin: 0;
    font-weight: 550;
    color: #fff;
  }

  .contato__card a {
    color: #fff;
  }

  @media (max-width: 860px) {
    .contato {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ isPlaceholder: site.whatsappIsPlaceholder }}>
  if (isPlaceholder) {
    document.querySelectorAll('[data-wa-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        const href = el.getAttribute('href') || '';
        if (href.startsWith('#') || href.includes('XXXXXXXX')) {
          const note = document.querySelector('.contato__placeholder');
          if (note) {
            note.setAttribute('tabindex', '-1');
            note.focus();
          }
        }
      });
    });
  }
</script>
