---
import { site, whatsappUrl, primaryContactIsWhatsApp } from '../config';
import Portrait from './Portrait.astro';
import contatoPhoto from '../assets/photos/tuany-contato.jpg';
const wa = whatsappUrl();
const showWa = primaryContactIsWhatsApp();
---

<section id="contato" aria-labelledby="contato-title">
  <div class="contato reveal" data-gradient-card>
    <div class="contato__copy">
      <p class="eyebrow" style="color: var(--rose-soft)">Contato</p>
      <h2 class="section__title split-headline" id="contato-title" data-split>Vamos conversar sobre o seu cuidado</h2>
      <p class="contato__lead">
        Envie uma mensagem pelo {showWa ? 'WhatsApp ou Instagram' : 'Instagram'}. Informe o motivo do
        atendimento e o bairro em Belo Horizonte para combinarmos a avaliação.
      </p>

      <div class="btn-row">
        {showWa ? (
          <a class="btn btn--wa btn--magnetic" href={wa} data-wa-cta rel="noopener noreferrer" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M20.5 3.5A11 11 0 0 0 3.1 17.7L2 22l4.4-1.1A11 11 0 1 0 20.5 3.5zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.6.7.7-2.5-.2-.3A9 9 0 1 1 12 20.5zm5-6.7c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.1-.3c0-.1 0-.3-.1-.4s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3a2 2 0 0 0-.6 1.5 3.5 3.5 0 0 0 .7 1.8c.1.2 1.4 2.2 3.4 3.1 2 .9 2 .6 2.4.6s1.2-.1 1.4-.3.9-1 1-1.2.2-.3.1-.5-.2-.2-.5-.3z"/>
            </svg>
            WhatsApp
          </a>
        ) : null}
        <a
          class:list={['btn', 'btn--magnetic', showWa ? 'btn--light' : 'btn--wa']}
          href={site.instagram.url}
          rel="noopener noreferrer"
          target="_blank"
        >
          Instagram {site.instagram.handle}
        </a>
      </div>
    </div>

    <div class="contato__side">
      <figure class="contato__photo clip-reveal" data-distort-photo data-rgb-hover data-photo-tilt>
        <div class="photo-parallax" data-photo-inner>
          <Portrait
            src={contatoPhoto}
            alt="Tuany Eduarda, fisioterapeuta, sorrindo"
            widths={[280, 420, 640, 900]}
            sizes="(max-width: 900px) min(88vw, 22rem), min(32vw, 22rem)"
            loading="lazy"
            objectPosition="50% 18%"
            class="contato__img"
          />
        </div>
        <figcaption class="sr-only">Retrato de {site.name}</figcaption>
      </figure>
      <div class="contato__card">
        <dl>
          <div>
            <dt>Profissional</dt>
            <dd>{site.name}</dd>
          </div>
          <div>
            <dt>CREFITO</dt>
            <dd>{site.crefito}</dd>
          </div>
          <div>
            <dt>Cidade</dt>
            <dd>{site.city}, {site.state}</dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd>
              <a class="link-underline" href={site.instagram.url} rel="noopener noreferrer" target="_blank">
                {site.instagram.handle}
              </a>
            </dd>
          </div>
          {showWa && (
            <div>
              <dt>WhatsApp</dt>
              <dd>{site.whatsapp}</dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .contato {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-6);
    align-items: stretch;
    background: linear-gradient(135deg, #3F4042, #58595B);
    color: var(--rose-50);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-lift);
    position: relative;
    overflow: hidden;
  }

  .contato .section__title {
    color: #fff;
    text-wrap: balance;
  }

  .contato__lead {
    color: var(--rose-100);
    font-size: var(--fs-lead);
    margin-bottom: var(--space-5);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .contato__side {
    display: grid;
    gap: 1.1rem;
  }

  .contato__photo {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    aspect-ratio: 3 / 4;
    border: 1px solid rgba(247, 243, 238, 0.12);
  }

  .contato__photo :global(picture),
  .contato__photo :global(img),
  .photo-parallax {
    width: 100%;
    height: 100%;
    display: block;
  }

  .photo-parallax {
    transform: scale(1.08);
    will-change: transform;
  }

  .contato__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }

  .contato__card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    backdrop-filter: blur(6px);
  }

  .contato__card dl {
    display: grid;
    gap: 1rem;
  }

  .contato__card dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-soft);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .contato__card dd {
    margin: 0;
    font-weight: 550;
    color: #fff;
  }

  .contato__card a {
    color: #fff;
  }

  @media (max-width: 860px) {
    .contato {
      grid-template-columns: 1fr;
    }
    .contato__photo {
      max-width: 22rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
