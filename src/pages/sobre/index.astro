---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sobre from '../../components/Sobre.astro';
import { site } from '../../config';
---
<BaseLayout
  title={`Sobre | ${site.name} — Fisioterapeuta`}
  description={`Conheça ${site.name}, fisioterapeuta (CREFITO ${site.crefito}), pós-graduada em Geriatria e Gerontologia, em Belo Horizonte.`}
  canonicalPath="/sobre/">
  <Header />
  <main id="conteudo" class="page-main">
    <header class="page-hero container" data-shared-hero>
      <p class="eyebrow">Sobre</p>
      <h1 class="page-title section__title" data-flip>Presença, escuta e cuidado</h1>
      <p class="section__lead">Pós-graduada em Geriatria e Gerontologia, com atendimento domiciliar. Também atua no tratamento de DTM e dor orofacial.</p>
    </header>
    <Sobre />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-main { padding-bottom: var(--space-6); }
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem; max-width: 42rem; }
</style>
