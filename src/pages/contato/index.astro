---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contato from '../../components/Contato.astro';
import { site } from '../../config';
---
<BaseLayout
  title={`Contato | ${site.name} — Fisioterapeuta`}
  description={`Fale com ${site.name} sobre atendimento domiciliar em Belo Horizonte.`}
  canonicalPath="/contato/">
  <Header />
  <main id="conteudo" class="page-main">
    <header class="page-hero container" data-shared-hero>
      <p class="eyebrow">Contato</p>
      <h1 class="page-title section__title" transition:name="page-title" data-flip>Vamos conversar</h1>
      <div class="contato-kinetic" aria-hidden="true">
        <div class="contato-kinetic__track">
          <span>Vamos conversar</span><span aria-hidden="true">·</span>
          <span>Vamos conversar</span><span aria-hidden="true">·</span>
          <span>Vamos conversar</span><span aria-hidden="true">·</span>
          <span>Vamos conversar</span><span aria-hidden="true">·</span>
        </div>
      </div>
      <p class="section__lead">Conte o motivo do contato para orientar o primeiro atendimento.</p>
    </header>
    <div class="container section section--tight">
      <Contato />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem; max-width: 48rem; position: relative; }
  .contato-kinetic {
    overflow: hidden;
    pointer-events: none;
    margin: 0 0 1rem;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .contato-kinetic__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    line-height: 1;
    color: #8A8B8D;
    animation: contato-marquee 22s linear infinite;
    white-space: nowrap;
  }
  @keyframes contato-marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contato-kinetic__track { animation: none; }
  }
</style>
